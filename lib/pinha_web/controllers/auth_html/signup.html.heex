<Layouts.app current_user={assigns[:current_user]} title="sign up">
  <div class="panes">
    <section class="pane">
      <header class="pane-head">
        <span>{if @first?, do: "Claim this server", else: "Sign up"}</span>
      </header>

      <p :if={@first?} class="lede">
        No one has an account here yet. The server wrote a claim token to its log when it
        started, and the account this form creates is the admin. An operator without the
        log can mint another token from the release console.
      </p>

      <p :if={not @first?} class="lede">
        Registration takes an invite. An admin mints one in their settings and hands it
        over; it admits one account and expires in a week. Leave it blank if an operator
        authorized this address from the console to replace a lost passkey.
      </p>

      <form class="form" id="signup" data-ceremony="signup">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          autocomplete="username webauthn"
          required
        />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />

        <label :if={@first?} for="claim">Claim token</label>
        <input :if={@first?} type="text" id="claim" name="claim" value={@claim} required />

        <label :if={not @first?} for="invite">Invite</label>
        <input
          :if={not @first?}
          type="text"
          id="invite"
          name="invite"
          placeholder="pinha_invite_…"
        />

        <label for="label">Passkey name</label>
        <input type="text" id="label" name="label" placeholder="laptop" />

        <button type="submit" class="primary">Create passkey</button>
        <p class="note" data-status></p>
      </form>

      <p class="lede">
        Already have an account? <a href="/signin">Sign in</a>.
      </p>
    </section>
  </div>
</Layouts.app>
