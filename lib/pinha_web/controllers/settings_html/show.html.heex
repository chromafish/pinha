<Layouts.app flash={@flash} current_user={assigns[:current_user]} title="settings" up="/">
  <div
    id="account"
    class="account-bar"
    style="display:flex; align-items:center; gap: var(--sp-2); min-height: var(--head-h); padding: 0 var(--edge); border-bottom: 1px solid var(--border-default); background: var(--surface-sunken); flex-wrap: wrap;"
  >
    <form
      id="update-username"
      method="post"
      action="/settings/username"
      style="display:flex; align-items:center; gap: var(--sp-2);"
    >
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="patch" />
      <span style="font: var(--type-body); white-space: nowrap;">Signed in as</span>
      <input
        type="text"
        id="username"
        name="username"
        value={Ecto.Changeset.get_field(@username_changeset, :username)}
        required
        autocomplete="off"
        spellcheck="false"
        style="width: 18ch; height: 28px; padding: 0 var(--sp-2); box-sizing: border-box; margin: 0; border: 1px solid var(--border-default); border-radius: var(--radius-1); vertical-align: middle;"
      />
      <span class="muted" style="white-space: nowrap;">· {@current_user.email}</span>
      <button
        type="submit"
        style="height: 28px; padding: 0 var(--sp-3); display:inline-flex; align-items:center; justify-content:center; box-sizing: border-box; margin: 0; border: 1px solid var(--border-default); border-radius: var(--radius-1); line-height: 1;"
      >
        Save
      </button>
      <button
        type="reset"
        style="height: 28px; padding: 0 var(--sp-3); display:inline-flex; align-items:center; justify-content:center; box-sizing: border-box; margin: 0; border: 1px solid var(--border-default); border-radius: var(--radius-1); line-height: 1;"
      >
        Cancel
      </button>
      <p
        :if={@username_changeset.action}
        class="error"
        style="flex-basis: 100%; margin: var(--sp-2) 0 0 0;"
      >
        {Enum.map_join(@username_changeset.errors, ", ", fn {field, {msg, _}} ->
          "#{field} #{msg}"
        end)}
      </p>
    </form>
  </div>

  <div id="settings" class="settings">
    <section id="passkeys" class="settings-pane">
      <header class="pane-head">
        <span>Passkeys</span>
        <span class="count">{length(@credentials)}</span>
      </header>

      <table class="table settings-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Added</th>
            <th scope="col">Last used</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={credential <- @credentials} data-row>
            <td class="wide" data-label="Name">{credential.label}</td>
            <td data-label="Added">{format_date(to_string(credential.inserted_at))}</td>
            <td data-label="Last used">
              {if credential.last_used_at,
                do: format_date(to_string(credential.last_used_at)),
                else: "never"}
            </td>
            <td class="right" data-label="Action">
              <form
                id={"remove-passkey-#{credential.id}"}
                method="post"
                action={"/settings/passkeys/#{credential.id}"}
                onsubmit="return confirm('Remove this passkey?')"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit">Remove</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>

      <form class="form" id="add-passkey" data-ceremony="add-passkey">
        <label for="passkey-label">Register another passkey</label>
        <input type="text" id="passkey-label" name="label" placeholder="phone" />
        <button type="submit">Add passkey</button>
        <p class="note" data-status></p>
      </form>
    </section>

    <section id="api-tokens" class="settings-pane">
      <header class="pane-head">
        <span>API tokens</span>
        <span class="count">{length(@tokens)}</span>
      </header>

      <div :if={@new_token} class="note-strong">
        <p>Copy this now. It is not shown again.</p>
        <code class="secret">{@new_token}</code>
        <p class="muted">
          Use it as the password when git asks, with your email as the username.
        </p>
      </div>

      <p :if={@tokens == []} class="empty">
        No tokens. Git needs one to clone or push, since a passkey cannot answer an HTTP
        Basic challenge.
      </p>

      <table :if={@tokens != []} class="table settings-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Created</th>
            <th scope="col">Expires</th>
            <th scope="col">Last used</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={token <- @tokens} data-row>
            <td class="wide" data-label="Name">{token.label}</td>
            <td data-label="Created">{format_date(to_string(token.inserted_at))}</td>
            <td data-label="Expires">
              {if token.expires_at, do: format_date(to_string(token.expires_at)), else: "never"}
            </td>
            <td data-label="Last used">
              {if token.last_used_at,
                do: format_date(to_string(token.last_used_at)),
                else: "never"}
            </td>
            <td class="right" data-label="Action">
              <form
                id={"revoke-token-#{token.id}"}
                method="post"
                action={"/settings/tokens/#{token.id}"}
                onsubmit="return confirm('Revoke this token? Anything using it stops working.')"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="danger">Revoke</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>

      <form id="mint-token" class="form" method="post" action="/settings/tokens">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label for="token-label">Mint a token</label>
        <input
          type="text"
          id="token-label"
          name="label"
          placeholder="laptop"
          data-focus
          required
        />
        <label for="token-expiry">Expiry in days</label>
        <input type="text" id="token-expiry" name="expires_in" placeholder="optional" />
        <button type="submit" class="primary">Mint token</button>
      </form>
    </section>

    <section id="ssh-keys" class="settings-pane">
      <header class="pane-head">
        <span>SSH keys</span>
        <span class="count">{length(@ssh_keys)}</span>
      </header>

      <p :if={@ssh_keys == []} class="empty">
        No keys. A key pushes without a prompt, since the agent already holds it.
      </p>

      <table :if={@ssh_keys != []} class="table settings-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col">Fingerprint</th>
            <th scope="col">Last used</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={key <- @ssh_keys} data-row>
            <td class="ssh-key-name" data-label="Name">{key.label}</td>
            <td data-label="Type">{key.algorithm}</td>
            <td class="fingerprint" data-label="Fingerprint">
              <code>{format_fingerprint(key.fingerprint)}</code>
            </td>
            <td data-label="Last used">
              {if key.last_used_at, do: format_date(to_string(key.last_used_at)), else: "never"}
            </td>
            <td class="right" data-label="Action">
              <form
                id={"remove-ssh-key-#{key.id}"}
                method="post"
                action={"/settings/ssh-keys/#{key.id}"}
                onsubmit="return confirm('Remove this key? Anything pushing with it stops working.')"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="danger">Remove</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>

      <form id="add-ssh-key" class="form" method="post" action="/settings/ssh-keys">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label for="ssh-key">Add a key</label>
        <textarea
          id="ssh-key"
          name="key"
          rows="3"
          placeholder="ssh-ed25519 AAAA... you@laptop"
          required
        ></textarea>
        <label for="ssh-key-label">Name</label>
        <input type="text" id="ssh-key-label" name="label" placeholder="optional" />
        <button type="submit">Add key</button>
      </form>

      <p class="muted">
        Clone over SSH with <code>{@ssh_clone_example}</code>.
      </p>
    </section>

    <section :if={@providers != []} id="providers" class="settings-pane">
      <header class="pane-head">
        <span>Linked accounts</span>
        <span class="count">{Enum.count(@providers, & &1.account)}</span>
      </header>

      <p class="empty">
        A linked account is what a mirror pushes under. Linking sends you to the provider and
        back; nothing is stored but who the token belonged to.
      </p>

      <table class="table settings-table">
        <thead>
          <tr>
            <th scope="col">Provider</th>
            <th scope="col">Account</th>
            <th scope="col">Linked</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={entry <- @providers} data-row>
            <td class="wide" data-label="Provider">{entry.provider.label()}</td>
            <td data-label="Account">
              {if entry.account, do: entry.account.login, else: "not linked"}
            </td>
            <td data-label="Linked">
              {if entry.account, do: format_date(to_string(entry.account.inserted_at)), else: "—"}
            </td>
            <td class="right" data-label="Action">
              <form
                id={"link-provider-#{entry.provider.name()}"}
                method="post"
                action={"/settings/providers/#{entry.provider.name()}"}
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button type="submit">
                  {if entry.account, do: "Relink", else: "Connect"}
                </button>
              </form>
              <form
                :if={entry.account}
                id={"unlink-provider-#{entry.provider.name()}"}
                method="post"
                action={"/settings/providers/#{entry.provider.name()}"}
                onsubmit="return confirm('Unlink this account? Mirrors it connected are disabled.')"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="danger">Unlink</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section :if={@current_user.admin} id="invites" class="settings-pane">
      <header class="pane-head">
        <span>Invites</span>
        <span class="count">{length(@invites)}</span>
      </header>

      <div :if={@new_invite} class="note-strong">
        <p>Copy this now. It is not shown again.</p>
        <code class="secret">{@new_invite}</code>
        <p class="muted">
          Whoever pastes it into the sign-up form gets one account, for a week.
        </p>
      </div>

      <p :if={@invites == []} class="empty">
        No invites. Every account here but the first one arrives on one.
      </p>

      <table :if={@invites != []} class="table settings-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Minted</th>
            <th scope="col">Expires</th>
            <th scope="col">Used by</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={invite <- @invites} data-row>
            <td class="wide" data-label="Name">{invite.label}</td>
            <td data-label="Minted">{format_date(to_string(invite.inserted_at))}</td>
            <td data-label="Expires">{format_date(to_string(invite.expires_at))}</td>
            <td data-label="Used by">
              {if invite.consumed_by, do: invite.consumed_by.username, else: "unused"}
            </td>
            <td class="right" data-label="Action">
              <form
                :if={is_nil(invite.consumed_at)}
                id={"revoke-invite-#{invite.id}"}
                method="post"
                action={"/settings/invites/#{invite.id}"}
                onsubmit="return confirm('Revoke this invite?')"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="danger">Revoke</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>

      <form id="mint-invite" class="form" method="post" action="/settings/invites">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label for="invite-label">Mint an invite</label>
        <input type="text" id="invite-label" name="label" placeholder="who it is for" />
        <button type="submit">Mint invite</button>
      </form>
    </section>
  </div>

  <:controls>
    <form id="signout" class="spacer" method="post" action="/signout">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="delete" />
      <button type="submit">Sign out</button>
    </form>
  </:controls>
</Layouts.app>
