<Layouts.app flash={@flash} current_user={assigns[:current_user]} title={@repo.name} up="/">
  <:badge>
    <.repository_kind_badge kind={@repo_kind} model={@repo.kind} />
  </:badge>

  <main class="repo-overview">
    <p :if={@repo.description} class="repo-description">{@repo.description}</p>

    <section id="repository-presentation" class="repo-presentation" data-expandable-panel>
      <div id="repository-presentation-content" class="repo-main">
        <section :if={assigns[:readme]} id="repository-readme" class="pane readme-pane">
          <header class="pane-head">
            <span>README</span>
            <span class="count">{@readme.filename}</span>
          </header>
          <div class="readme">
            {@readme.html}
          </div>
        </section>

        <section id="repository-history" class="pane history-pane">
          <header class="pane-head">
            <span>
              {if(jj_history?(@repo_kind), do: "Recent changes", else: "Recent commits")}
            </span>
            <span class="count">{length(@commits)}</span>
          </header>

          <p :if={@commits == []} class="empty">
            {if(jj_history?(@repo_kind),
              do: "No changes have been published.",
              else: "No commits have been pushed."
            )}
          </p>

          <table :if={@commits != []} class="table">
            <thead>
              <tr>
                <th :if={jj_history?(@repo_kind)}>Change</th>
                <th>Commit</th>
                <th>Message</th>
                <th>Author</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={commit <- @commits} data-row>
                <td :if={jj_history?(@repo_kind)} class="change-id">{short(commit.change_id)}</td>
                <td>
                  <a
                    class={["id", jj_history?(@repo_kind) && "id-secondary"]}
                    href={commit_path(@repo.name, commit.id)}
                  >
                    {short(commit.id)}
                  </a>
                </td>
                <td class="prose wide">{commit.subject}</td>
                <td class="prose">{commit.author_name}</td>
                <td class="right">{format_date(commit.author_date)}</td>
              </tr>
            </tbody>
          </table>
        </section>
      </div>

      <footer class="repo-presentation-actions">
        <button
          type="button"
          class="repo-presentation-toggle"
          aria-expanded="false"
          aria-controls="repository-presentation-content"
          data-expand-toggle
        >
          <span data-expand-label>Show all</span>
        </button>
      </footer>
    </section>

    <div class="repo-tools">
      <section id="repository-tree" class="pane repo-tree">
        <header class="pane-head">
          <span>Files</span>
          <span :if={@tree_target} class="tree-target">
            <span class="tree-target-label">{@tree_target.label}</span>
            <a
              :if={@repo_kind == :git}
              class="ref"
              href={tree_path(@repo.name, @tree_target.name)}
            >
              {@tree_target.name}
            </a>
            <a class="id" href={commit_path(@repo.name, @tree_target.id)}>
              {short(@tree_target.id)}
            </a>
            <span :if={Map.get(@tree_target, :change_id)} class="tree-target-change">
              <span class="tree-target-key">change</span>
              <span class="change-id">{short(@tree_target.change_id)}</span>
            </span>
          </span>
          <span class="count">{length(@tree_entries)}</span>
        </header>

        <nav
          :if={@tree_target && @tree_entries != []}
          id="repository-files"
          class="tree-explorer"
          aria-label={"Files at #{@tree_target.label} #{short(@tree_target.id)}"}
        >
          <a
            :for={entry <- @tree_entries}
            class="tree-entry"
            href={tree_path(@repo.name, @tree_target.name, entry.path)}
          >
            <span class="path">
              {if entry.type == "tree", do: entry.name <> "/", else: entry.name}
            </span>
            <span class="tree-entry-size">{format_bytes(entry.size)}</span>
          </a>
        </nav>

        <p :if={@tree_entries == []} class="tree-empty">
          <%= cond do %>
            <% @tree_target -> %>
              This revision has no files.
            <% jj_history?(@repo_kind) -> %>
              No published commit to browse.
            <% true -> %>
              No default branch to browse.
          <% end %>
        </p>
      </section>

      <section id="repository-refs" class="pane repo-refs">
        <header class="pane-head">
          <span>
            {if(jj_history?(@repo_kind), do: "Bookmarks & tags", else: "Branches & tags")}
          </span>
          <span class="count">{length(@bookmarks) + length(@tags)}</span>
        </header>

        <table :if={@bookmarks != []} class="table">
          <thead>
            <tr>
              <th>{if(jj_history?(@repo_kind), do: "Bookmark", else: "Branch")}</th>
              <th>Commit</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={bookmark <- @bookmarks} data-row>
              <td>
                <a
                  class={["ref", jj_history?(@repo_kind) && "bookmark-ref"]}
                  href={tree_path(@repo.name, bookmark.name)}
                >
                  {bookmark.name}
                </a>
                <span
                  :if={bookmark.name == @default_bookmark}
                  class={["tag", jj_history?(@repo_kind) && "tag-muted"]}
                >
                  {if(jj_history?(@repo_kind), do: "git HEAD", else: "default")}
                </span>
              </td>
              <td>
                <a
                  class={["id", jj_history?(@repo_kind) && "id-secondary"]}
                  href={commit_path(@repo.name, bookmark.id)}
                >
                  {short(bookmark.id)}
                </a>
              </td>
              <td class="right">{format_date(bookmark.date)}</td>
            </tr>
          </tbody>
        </table>

        <p :if={@bookmarks == []} class="empty">
          <%= if jj_history?(@repo_kind) do %>
            No bookmarks.
          <% else %>
            No branches. Push one: <code>git push origin main</code>.
          <% end %>
        </p>

        <table :if={@tags != []} class="table">
          <thead>
            <tr>
              <th>Tag</th>
              <th>Commit</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={tag <- @tags} data-row>
              <td><a class="ref" href={tree_path(@repo.name, tag.name)}>{tag.name}</a></td>
              <td>
                <a
                  class={["id", jj_history?(@repo_kind) && "id-secondary"]}
                  href={commit_path(@repo.name, tag.id)}
                >
                  {short(tag.id)}
                </a>
              </td>
            </tr>
          </tbody>
        </table>

        <p :if={@tags == []} class="empty">
          <%= if jj_history?(@repo_kind) do %>
            No tags.
          <% else %>
            No tags. Push one: <code>git push origin v1</code>.
          <% end %>
        </p>
      </section>
    </div>

    <section
      :if={@mirror || @mirror_providers != []}
      id="repository-mirror"
      class="pane repo-mirror"
    >
      <header class="pane-head">
        <span>Mirror</span>
        <span :if={@mirror} class="count">{mirror_state_label(@mirror)}</span>
      </header>

      <%= if @mirror do %>
        <dl class="kv">
          <dt>target</dt>
          <dd><a href={@mirror.target_url} rel="noopener">{@mirror.target_name}</a></dd>
          <dt>state</dt>
          <dd>{mirror_state_label(@mirror)}</dd>
          <dt>last sync</dt>
          <dd>
            {if @mirror.last_synced_at,
              do: format_date(to_string(@mirror.last_synced_at)),
              else: "never"}
            <span :if={Mirror.behind?(@mirror)} class="tag">behind</span>
          </dd>
          <dt :if={@mirror.last_failed_at}>last failure</dt>
          <dd :if={@mirror.last_failed_at}>
            {format_date(to_string(@mirror.last_failed_at))}
          </dd>
          <dt :if={@mirror.held_refs != []}>held</dt>
          <dd :if={@mirror.held_refs != []}>{Enum.join(@mirror.held_refs, ", ")}</dd>
        </dl>

        <p :if={@may_write && @mirror.last_failure} class="notice notice-error">
          {@mirror.last_failure}
        </p>

        <p :if={@mirror.state == "awaiting_access"} class="empty">
          The provider cannot reach the target yet.
          <a :if={@mirror_access_url} href={@mirror_access_url} rel="noopener">
            Grant it access
          </a>
          and check again.
        </p>

        <div :if={@may_write} class="mirror-controls">
          <form
            :if={@mirror.state == "active"}
            id="mirror-sync"
            method="post"
            action={repo_path(@repo.name) <> "/mirror/sync"}
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">
              {if Mirror.failing?(@mirror), do: "Retry", else: "Sync now"}
            </button>
          </form>

          <form
            :if={@mirror.state == "awaiting_access"}
            id="mirror-check"
            method="post"
            action={repo_path(@repo.name) <> "/mirror/check"}
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">Check again</button>
          </form>

          <form
            :if={@mirror.state == "disabled"}
            id="mirror-enable"
            method="post"
            action={repo_path(@repo.name) <> "/mirror/enable"}
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">Enable</button>
          </form>

          <form
            :if={@mirror.state != "disabled"}
            id="mirror-disable"
            method="post"
            action={repo_path(@repo.name) <> "/mirror/disable"}
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button type="submit">Disable</button>
          </form>

          <form
            id="mirror-disconnect"
            method="post"
            action={repo_path(@repo.name) <> "/mirror"}
            onsubmit="return confirm('Disconnect this mirror? The target is left as it is.')"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="_method" value="delete" />
            <button type="submit" class="danger">Disconnect</button>
          </form>
        </div>
      <% else %>
        <form
          :for={entry <- @mirror_providers}
          id={"mirror-connect-#{entry.provider.name()}"}
          class="form"
          method="post"
          action={repo_path(@repo.name) <> "/mirror"}
        >
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="provider" value={entry.provider.name()} />

          <p :if={is_nil(entry.account)} class="empty">
            Link your {entry.provider.label()} account in <a href="/settings">settings</a>
            to mirror this repository there.
          </p>

          <label :if={entry.account} for={"mirror-account-#{entry.provider.name()}"}>
            {entry.provider.label()} account
          </label>
          <input
            :if={entry.account}
            type="text"
            id={"mirror-account-#{entry.provider.name()}"}
            name="account"
            value={entry.account.login}
            required
          />

          <label :if={entry.account} for={"mirror-name-#{entry.provider.name()}"}>
            Repository name
          </label>
          <input
            :if={entry.account}
            type="text"
            id={"mirror-name-#{entry.provider.name()}"}
            name="name"
            value={@repo.name}
            required
          />

          <label :if={entry.account}>
            <input type="radio" name="mode" value="new" checked /> Create a new private
            repository
          </label>
          <label :if={entry.account}>
            <input type="radio" name="mode" value="existing" /> Use an existing one
          </label>
          <label :if={entry.account}>
            <input type="checkbox" name="confirm" value="true" /> I understand an existing
            repository's branches and tags are replaced
          </label>
          <input type="hidden" name="private" value="true" />

          <button :if={entry.account} type="submit">Connect mirror</button>
        </form>
      <% end %>
    </section>
  </main>

  <:controls>
    <div class="field-set">
      <span class="field">
        <span class="key">https</span> <code>{clone_url(@repo.name)}</code>
      </span>
      <span class="field">
        <span class="key">ssh</span> <code>{ssh_clone_url(@repo.name)}</code>
      </span>
      <span class="field">
        <span class="key">owner</span>
        <span>{(@owner && @owner.username) || "unassigned"}</span>
      </span>
    </div>

    <form :if={@may_write} method="post" action={repo_path(@repo.name) <> "/owner"}>
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        type="text"
        name="username"
        list="repo-owners"
        placeholder="hand to (username)"
        required
      />
      <datalist id="repo-owners">
        <option :for={user <- @users} value={user.username}></option>
      </datalist>
      <button type="submit">Set owner</button>
    </form>

    <form
      :if={@may_write}
      class="spacer"
      method="post"
      action={repo_path(@repo.name)}
      onsubmit="return confirm('Delete this repository? This removes all history and metadata.')"
    >
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="delete" />
      <button type="submit" class="danger">Delete repository</button>
    </form>
  </:controls>
</Layouts.app>
