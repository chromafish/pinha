<Layouts.app current_user={assigns[:current_user]} up="/">
  <div class="panes">
    <section class="pane">
      <header class="pane-head">
        <span>Fault</span>
        <span class="count">{@status}</span>
      </header>

      <div class="fault">
        <p class="code">{@status}</p>
        <p>{@message}</p>
        <p>The repository list is at <a href="/">/</a>.</p>
      </div>
    </section>
  </div>
</Layouts.app>
